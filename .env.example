# ============ 复制本文件为 .env 并填写 ============
# .env 已被 .gitignore 忽略，绝不会上传到 git，请放心把真 Key 放这里。

# 你的 OpenAI 兼容网关地址（要以 /v1 结尾）
GATEWAY_BASE_URL=https://your-gateway.example.com/v1

# 你的网关 API Key
GATEWAY_API_KEY=sk-请替换成你的key

# 本地代理自己的访问密码（Claude Code 里填这个，随便起个难猜的）
LITELLM_MASTER_KEY=sk-litellm-local
