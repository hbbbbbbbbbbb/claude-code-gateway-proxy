<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.litellm-proxy</string>

  <!-- 把下面两处 /Users/YOUR_USERNAME/... 改成你的项目实际路径 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/claude-code-gateway-proxy/start.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/claude-code-gateway-proxy/proxy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/claude-code-gateway-proxy/proxy.err.log</string>
</dict>
</plist>
